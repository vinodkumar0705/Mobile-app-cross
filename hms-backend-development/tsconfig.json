{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "node",
        "target": "ES2023",
        "strict": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "5.0",
        "paths": {
            "@/*": ["./src/*"]
        },
        "outDir": "build",
        "baseUrl": "."
    },

    "include": ["**/*", "index.ts"],
    "exclude": ["node_modules", "build"]
}