    parameterValues  TestParameterValue[]
    labReport        LabReport?
    medicalHistories MedicalHistory[]
    employeeInfo     EmployeeInfo?        @relation(fields: [employeeInfoId], references: [id])
    employeeInfoId   String?

    @@index([labOrderId])
    @@index([patientId, testDate])
    @@index([status])
}

model TestParameterValue {
    id              String  @id @default(cuid())
    labTestResultId String
    labParameterId  String
    value           String
    unit            String?
    referenceRange  String?
    isAbnormal      Boolean @default(false)
    remarks         String?
    attachmentUrl   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    labTestResult LabTestResult @relation(fields: [labTestResultId], references: [id], onDelete: Cascade)
    labParameter  LabParameter  @relation(fields: [labParameterId], references: [id])

    @@unique([labTestResultId, labParameterId])
    @@index([labTestResultId])
}

model LabReport {
    id              String          @id @default(cuid())
    labTestResultId String          @unique
    patientId       String
    validatorId     String?
    versionNumber   Int             @default(1)
    checksum        String?
    finalizedDate   DateTime?
    reportData      Json?
    pdfUrl          String?
    status          LabResultStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    labTestResult  LabTestResult    @relation(fields: [labTestResultId], references: [id])
    patient        PatientInfo      @relation(fields: [patientId], references: [id])
    validator      EmployeeInfo?    @relation("ReportValidator", fields: [validatorId], references: [id])
    auditLogs      LabReportAudit[]
    employeeInfo   EmployeeInfo?    @relation(fields: [employeeInfoId], references: [id])
    employeeInfoId String?

    @@index([patientId])
    @@index([status])
    @@index([finalizedDate])
}

model LabReportAudit {
    id          String           @id @default(cuid())
    labReportId String
    changedById String
    action      String // CREATED | STATUS_CHANGED | VERIFIED | FINALIZED | REJECTED
    oldStatus   LabResultStatus?
    newStatus   LabResultStatus?
    remarks     String?
    timestamp   DateTime         @default(now())

    labReport LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)
    changedBy User      @relation(fields: [changedById], references: [id])

    @@index([labReportId])
    @@index([changedById, timestamp])
}
