model Batch {
    id            String    @id @default(cuid())
    itemId        String
    batchNumber   String
    mfgDate       DateTime? // Manufacturing date
    expiryDate    DateTime? // Optional for non-expiring items
    quantity      Int       @default(0)
    unitsPerStrip Int?
    purchaseDate  DateTime? @default(now()) // When this batch was purchased
    sellingPrice  Float?    @ignore
    costPrice     Float?    @ignore
    mrp           Float?    @ignore
    supplier      String?

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    item          MedicalItem     @relation(fields: [itemId], references: [id])
    movements     StockMovement[]
    dispensations Dispensation[]

    @@unique([itemId, batchNumber])
    @@index([expiryDate])
    @@index([mfgDate])
    @@index([isActive])
    @@index([itemId, expiryDate])
}

model StockMovement {
    id           String            @id @default(cuid())
    batchId      String
    movementType StockMovementType
    quantity     Int
    reason       String?

    // Link to dispensation if this removal was a sale
    dispensationId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    batch        Batch         @relation(fields: [batchId], references: [id])
    dispensation Dispensation? @relation(fields: [dispensationId], references: [id])

    @@index([batchId])
    @@index([movementType])
    @@index([quantity])
    @@index([dispensationId])
}

enum StockMovementType {
    ADD
    REMOVE
}

enum DispensationStatus {
    PENDING
    COMPLETED
}

model Dispensation {
    id             String  @id @default(cuid())
    prescriptionId String? // Optional (for non-prescription items)
    batchId        String
    pharmacistId   String?

    dispensedDate DateTime @default(now())
    quantity      Int
    unitsPerStrip Int?
    sellingPrice  Float
    totalAmount   Float
    discount      Float?

    // For direct sales without prescription
    customerName  String?
    customerPhone String?

    status DispensationStatus @default(COMPLETED)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    prescription Prescription?   @relation(fields: [prescriptionId], references: [id])
    batch        Batch           @relation(fields: [batchId], references: [id])
    pharmacist   EmployeeInfo?   @relation("PharmacyDispensations", fields: [pharmacistId], references: [id])
