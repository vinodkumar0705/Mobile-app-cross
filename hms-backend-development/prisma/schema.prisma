model MedicalItem {
    id          String  @id @default(cuid())
    name        String
    description String?

    // Classification
    itemType MedicalItemType

    unit        String // "Tablet", "Vial", "Box", "Pack", "Piece"
    strength    String? // "500mg", "5ml" (for medicines only)
    dosageForm  String? // "Tablet", "Injection", "Syrup" (for medicines only)
    genericName String? // (for medicines only)
    brand       String?

    isActive Boolean @default(true)

    hasExpiry         Boolean @default(true) // Some items don't expire (like surgical tools)
    requiresColdChain Boolean @default(false)
