// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum MediaType {
    IMAGE
    VIDEO
    PDF
    DOCUMENT
}

model Media {
    id     String    @id @default(cuid())
    type   MediaType
    url    String
    name   String
    size   Int?
    isLink Boolean   @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([url])
}

enum OrganizationStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
}

model Organization {
    id String @id @default(cuid())

    brandName                   String    @unique
    legalName                   String    @unique
    licenseNumber               String?
    licenseExpiryDate           DateTime?
    establishmentDate           DateTime?
    taxIdentificationNumber     String?
    registeredAddress           String?
    autherizedAdmininstitorName String?
    officialEmail               String?
    officialPhoneNumber         String?
    organizationLogo            String?
    organizationTagline         String?
    opdStartTime                String?   @default("09:00")
    opdEndTime                  String?   @default("18:00")
    opdDuration                 String?   @default("15") //minutes
    patientIdPrefix             String?
    employeeIdPrefix            String?
    patientIdCounter            Int       @default(0)
    employeeIdCounter           Int       @default(0)
    idLength                    Int?
    consultationSpan            Int?      @default(15)
    consultationAttempts        Int?      @default(1)
    timezone                    String?   @default("Asia/Kolkata")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    status OrganizationStatus

    users    User[]   @relation("organization-user-m2m")
    branches Branch[] @relation("organization-branch-m2m")
}

model Branch {
    id             String @id @default(cuid())
    organizationId String

    name        String  @unique
    city        String?
    address     String?
    phoneNumber String?
    email       String?
    managerName String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    buildings    Building[]
    organization Organization @relation("organization-branch-m2m", fields: [organizationId], references: [id])
    users        User[]       @relation("branch-user-m2m")
}

model User {
    id             String  @id @default(cuid())
    patientInfoId  String?
    employeeInfoId String?

    email       String?         @unique
    username    String?         @unique
    phoneNumber String?
    fName       String?
    lName       String?
    bloodGroup  BloodGroupType?
    password    String?         @default("00000000")
    isPatient   Boolean         @default(false)
    isDoctor    Boolean         @default(false)
    isAdmin     Boolean         @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    patientInfo              PatientInfo?
    employeeInfo             EmployeeInfo?
    userFormField            UserFormField[]
    unavailability           Unavailability[]      @relation("UserUnavailability")
    roles                    Role[]                @relation("user-roles-m2m")
    userCalendarSettings     UserCalendarSettings?
    organization             Organization[]        @relation("organization-user-m2m")
    branch                   Branch[]              @relation("branch-user-m2m")
    roomBookingsWith         RoomBooking[]         @relation("DoctorRoomBookings")
    recordedMedicalHistories MedicalHistory[]
    labReportAudits          LabReportAudit[]

    @@index([email, phoneNumber, username])
}

enum BloodGroupType {
    A_PLUS   @map("A+")
    B_PLUS   @map("B+")
    AB_PLUS  @map("AB+")
    O_PLUS   @map("O+")
    A_MINUS  @map("A-")
    B_MINUS  @map("B-")
    AB_MINUS @map("AB-")
    O_MINUS  @map("O-")
    OTHER
}

model PatientInfo {
    id     String @id @default(cuid())
    userId String @unique

    age                      String?
    gender                   String?
    email                    String?
    phoneNumber              String?
    weight                   String?
    height                   String?
    insuranceProvider        String?
    policyNumber             String?
    policyHolderName         String?
    policyExpiryDate         DateTime?
    tpaName                  String?
    emergencyContact         String?
    emergencyContactName     String?
    emergencyContactRelation String?
    emergencyContactNotes    String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    visitsBy               Visit[]
    medicalHistories       MedicalHistory[]       @relation("PatientMedicalHistory")
    patientAppointments    Appointment[]          @relation("PatientAppointments")
    referrals              Reference[]            @relation("RefferalPatient")
    roomBookingsfor        RoomBooking[]          @relation("PatientRoomBookings")
    prescribedTo           Prescription[]         @relation("PatientPrescriptions")
    user                   User                   @relation(fields: [userId], references: [id])
    patientMedicalDocument MedicalDocument[]      @relation("MedicalDocuments")
    medicalDocuments       MedicalDocument[]
    labOrders              LabOrder[]
    patientDiets           Diet[]                 @relation("PatientDiets")
    patientVitals          PatientVitals[]
    dischargeSummaries     DischargeSummary[]
    admissions             Admission[]
    staySessions           InpatientStaySession[]
    physioTherapy          PhysioTherapy[]
    Bills                  Bill[]
    patientProcedures      PatientProcedure[]
    treatments             Treatment[]
    paymentDetails         PaymentDetails[]
    patientMeals           PatientMeal[]
    labTestResults         LabTestResult[]
    labReports             LabReport[]
}

model EmployeeInfo {
    id     String @id @default(cuid())
    userId String @unique

    highestQualification String?
    institutionName      String?
    graduationYear       String?
    emergencyContact     String?
    emergencyName        String?
    relationship         String?
    licenseNumber        String?
    licenseExpiry        String?

    hireDate                 String?
    dateOfBirth              String?
    address                  String?
    additionalCertifications String?
    experience               Int?    @default(0)
    salary                   Int?    @default(0)
    age                      String?
    gender                   String?
    specialityId             String?
    consultationCharge       String? @ignore

    department    Department[]
    qualification Qualification[]
    visitsTo      Visit[]

    createdAt                DateTime               @default(now())
    updatedAt                DateTime               @updatedAt
    departmentId             String?
    speciality               Speciality?            @relation(fields: [specialityId], references: [id])
    appointments             Appointment[]          @relation("DoctorAppointments")
    user                     User                   @relation(fields: [userId], references: [id])
    references               Reference[]            @relation("ReferralEmployee")
    prescribedBy             Prescription[]         @relation("DoctorPrescriptions")
    dispensations            Dispensation[]         @relation("PharmacyDispensations")
    dischargeSummaries       DischargeSummary[]
    doctorDischargeSummaries DischargeSummary[]     @relation("DischargeSummary")
    admissions               Admission[]            @relation("AdmittingDoctorAdmissions")
    labOrders                LabOrder[]
    vital                    PatientVitals[]
    doctors                  PatientProcedure[]     @relation("doctors")
    supportingStaff          PatientProcedure[]     @relation("supportingStaff")
    treatments               Treatment[]
    followUpDoctor           DischargeSummary[]     @relation("FollowUpDoctor")
    referralUsers            ReferralUsers[]
    prescriptionTemplates    PrescriptionTemplate[]
    labTestResults           LabTestResult[]
    labReports               LabReport[]
    labResultsOrdered        LabTestResult[]        @relation("LabResultDoctor")
    labResultsEntered        LabTestResult[]        @relation("LabResultEnteredBy")
    labResultsVerified       LabTestResult[]        @relation("LabResultVerifiedBy")
    validatedReports         LabReport[]            @relation("ReportValidator")
    physioTherapy            PhysioTherapy[]
}

model Role {
    id String @id @default(cuid())

    name String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    users       User[]       @relation("user-roles-m2m")
    permissions Permission[]
}

model Department {
    id String @id @default(cuid())

    name             String       @unique
    departmentCode   String?
    medicalSpecialty String?
    description      String?
    headDoctor       String?
    patientCapacity  Int?
    contactEmail     String?
    contactPhone     String?
    location         String?
    departmentType   String?
    status           String?
    speciality       Speciality[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    employees EmployeeInfo[]
}

model Speciality {
    id String @id @default(cuid())

    name         String
    description  String?
    departmentId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    department    Department?    @relation(fields: [departmentId], references: [id])
    employeeInfos EmployeeInfo[]
}

model Qualification {
    id String @id @default(cuid())

    name String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    employees EmployeeInfo[]
}

//----------------forms----------------->

model Form {
    id String @id @default(cuid())

    name String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    fields FormField[]
}

enum FieldType {
    text
    number
    date
    file
    select
    multiSelect
}

model FormField {
    id     String @id @default(cuid())
    formId String

    name  String    @unique
    type  FieldType
    order Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    options        FormFieldOption[]
    userFormFields UserFormField[]
    form           Form              @relation(fields: [formId], references: [id])
}

model FormFieldOption {
    id          String @id @default(cuid())
    formFieldId String

    name String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    formField FormField @relation(fields: [formFieldId], references: [id])
}

//<----------------forms----------------

//----------------User data in form---------------->
model UserFormField {
    id          String @id @default(cuid())
    formfieldId String
    userId      String

    value          String
    valueSecondary String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    formfield FormField @relation(fields: [formfieldId], references: [id])
    user      User      @relation(fields: [userId], references: [id])
}

//<----------------User data in form----------------

//-----------------Permission------------------>
model Permission {
    id String @id @default(cuid())

    name        String
    code        String @unique
    description String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    roles Role[]
}

//<----------------Permission------------------

//-----------------Availability------------------
model TimeSlot {
    id String @id @default(cuid())

    startTime DateTime
    endTime   DateTime
    order     Int?

    @@unique([startTime, endTime])
    @@index([startTime, endTime])
}

model UserCalendarSettings {
    id     String @id @default(cuid())
    userId String @unique

    slotDuration       Int      @default(30) // in minutes
    bufferTime         Int      @default(5) // in minutes
    maxBookingsPerDay  Int      @default(10)
    advanceBookingDays Int      @default(30)
    workingDays        String[] // ["MON", "TUE", "WED", "THU", "FRI"]
    startOfDay         String   @default("09:00") // HH:mm format
    endOfDay           String   @default("17:00") // HH:mm format

    user User @relation(fields: [userId], references: [id])
}

enum AppointmentStatus {
    SCHEDULED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELLED
    NO_SHOW
}

enum AppointmentType {
    NEW_APPOINTMENT
    FOLLOW_UP
}

model Appointment {
    id        String  @id @default(cuid())
    doctorId  String // The doctor/user
    patientId String? // If patients are also users

    title             String?
    description       String?
    reason            String?
    startTime         DateTime?
    endTime           DateTime?
    paidAmount        Int?
    sourceAdmissionId String?
    status            AppointmentStatus @default(SCHEDULED)
    appointmentType   AppointmentType?
    appointmentDate   DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    doctor          EmployeeInfo @relation("DoctorAppointments", fields: [doctorId], references: [id])
    patient         PatientInfo? @relation("PatientAppointments", fields: [patientId], references: [id])
    admissions      Admission[]  @relation("AppointmentToAdmission")
    sourceAdmission Admission?   @relation("AdmissionToAppointment", fields: [sourceAdmissionId], references: [id])
    bills           Bill[]
    // availability Availability? @relation(fields: [availabilityId], references: [id])

    medicalHistories MedicalHistory[]
    visits           Visit[]
    patientVitals    PatientVitals[]
    referral         Reference?
    treatments       Treatment[]
    physioTherapy    PhysioTherapy[]

    @@index([doctorId, startTime])
    @@index([patientId])
}

model Unavailability {
    id             String    @id @default(cuid())
    userId         String
    startTime      DateTime // Start of availability
    endTime        DateTime? // End of availability
    isRecurring    Boolean   @default(false)
    recurrenceRule String? // For recurring availability (RRULE format)
    isAllDay       Boolean   @default(false) // For whole-day availability
    timeZone       String    @default("UTC")

    // For blocking specific dates in recurring patterns
    exceptionDates DateTime[] // Dates to exclude from recurrence

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation("UserUnavailability", fields: [userId], references: [id])

    @@index([userId])
    @@index([startTime, endTime])
}

//-----------------Admission------------------>
enum AdmissionStatus {
    PLANNED
    ADMITTED
    DISCHARGE_STARTED
    DISCHARGED
    CANCELLED
}

enum AdmissionSourceType {
    DIRECT
    FROM_APPOINTMENT
    FROM_VISIT
    FROM_EMERGENCY
}

enum StaySessionStatus {
    ACTIVE
    DISCHARGED
    ABSCONDED
    CANCELLED
}

model Admission {
    id String @id @default(cuid())

    patientId           String
    admittingDoctorId   String
    sourceType          AdmissionSourceType
    sourceAppointmentId String?
    sourceVisitId       String?

    reason            String?
    admissionDateTime DateTime        @default(now())
    expectedDischarge DateTime?
    actualDischarge   DateTime?
    paymentType       PaymentType?    @default(OTHER)
    amount            String?
    txnId             String?
    status            AdmissionStatus @default(ADMITTED)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    patient           PatientInfo           @relation(fields: [patientId], references: [id])
    admittingDoctor   EmployeeInfo          @relation("AdmittingDoctorAdmissions", fields: [admittingDoctorId], references: [id])
    sourceAppointment Appointment?          @relation("AppointmentToAdmission", fields: [sourceAppointmentId], references: [id])
    sourceVisit       Visit?                @relation("VisitToAdmission", fields: [sourceVisitId], references: [id])
    staySession       InpatientStaySession?
    dischargeSummary  DischargeSummary?
    medicalHistories  MedicalHistory[]
    patientProcedures PatientProcedure[]
    treatments        Treatment[]
    reference         Reference?
    paymentDetails    PaymentDetails[]
    bills             Bill[]
    physioTherapy     PhysioTherapy[]
    appointment       Appointment[]         @relation("AdmissionToAppointment")

    @@index([patientId, admissionDateTime])
    @@index([admittingDoctorId, admissionDateTime])
    @@index([status])
    @@index([sourceAppointmentId])
    @@index([sourceVisitId])
}

model InpatientStaySession {
    id String @id @default(cuid())

    admissionId String @unique
    patientId   String

    startedAt DateTime          @default(now())
    endedAt   DateTime?
    status    StaySessionStatus @default(ACTIVE)

    currentRoomBookingId String?
    notes                String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    admission          Admission      @relation(fields: [admissionId], references: [id])
    patient            PatientInfo    @relation(fields: [patientId], references: [id])
    currentRoomBooking RoomBooking?   @relation("CurrentStayRoomBooking", fields: [currentRoomBookingId], references: [id])
    transfers          StayTransfer[]
    visits             Visit[]

    @@index([patientId, startedAt])
    @@index([status])
    @@index([currentRoomBookingId])
}

model StayTransfer {
    id String @id @default(cuid())

    staySessionId String

    fromRoomId String?
    toRoomId   String

    effectiveFrom DateTime  @default(now())
    effectiveTo   DateTime?
    reason        String?
    transferredBy String?
    roomCharges   Float?    @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    staySession InpatientStaySession @relation(fields: [staySessionId], references: [id])
    fromRoom    Room?                @relation("StayTransferFromRoom", fields: [fromRoomId], references: [id])
    toRoom      Room                 @relation("StayTransferToRoom", fields: [toRoomId], references: [id])

    @@index([staySessionId, effectiveFrom])
    @@index([fromRoomId])
    @@index([toRoomId])
}

//<----------------Availability----------------

//-----------------Infrastructure-----------------------
model Building {
    id       String @id @default(cuid())
    branchId String

    name           String  @unique
    buildingCode   String?
    numberOfFloors Int?

    branch Branch @relation(fields: [branchId], references: [id])

    floor Floor[]
}

model Floor {
    id         String @id @default(cuid())
    buildingId String

    name String @unique

    room     Room[]
    building Building @relation(fields: [buildingId], references: [id])
}

model Amenity {
    id          String  @id @default(cuid())
    name        String  @unique
    icon        String? // For UI display
    description String?

    room Room[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("amenities")
}

model RoomType {
    id          String  @id @default(cuid())
    name        String  @unique
    description String?
    price       Float   @default(0) @ignore

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    room Room[]
}

enum RoomStatus {
    AVAILABLE
    OCCUPIED
    MAINTENANCE
    CLEANING_IN_PROGRESS
    RESERVED
    OUT_OF_SERVICE
}

model Room {
    id String @id @default(cuid())

    roomTypeId String
    floorId    String // "1", "2", "Ground"

    roomNumber             String // "101", "A-12", etc.
    name                   String // "Consultation Room 1", "Operation Theater 3"
    amenities              Amenity[]
    capacity               Int        @default(1) // Max people allowed
    equipment              String[] // ["Exam Table", "ECG", "Ultrasound"]
    isWheelchairAccessible Boolean    @default(true)
    isAvailable            Boolean    @default(true)
    status                 RoomStatus @default(AVAILABLE)
    currentOccupancy       Int        @default(0)
    description            String?
    notes                  String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    roomType      RoomType       @relation(fields: [roomTypeId], references: [id])
    floor         Floor          @relation(fields: [floorId], references: [id])
    roomBookings  RoomBooking[]
    transfersFrom StayTransfer[] @relation("StayTransferFromRoom")
    transfersTo   StayTransfer[] @relation("StayTransferToRoom")
    // roomSchedules RoomSchedule[]

    @@index([status])
}

enum RoomBookingStatus {
    CONFIRMED
    COMPLETED
    CHECK_OUT
    CANCELLED
    NO_SHOW
}

model RoomBooking {
    id            String  @id @default(cuid())
    roomId        String?
    appointmentId String? // Links to appointment
    doctorId      String? // If booking without appointment
    patientId     String? // If booking without appointment

    // Booking details
    title       String? // "Annual Checkup", "Surgery", "Team Meeting"
    description String?
    startTime   DateTime
    endTime     DateTime?
    timeZone    String    @default("UTC")
    roomCharges Float     @default(0)

    // Participants
    attendees String[] // User IDs of attendees

    // Status
    status             RoomBookingStatus @default(CONFIRMED)
    cancellationReason String?

    // Recurrence (for regular meetings)
    isRecurring     Boolean @default(false)
    recurrenceRule  String?
    parentBookingId String? // For recurrence series

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    room         Room?                   @relation(fields: [roomId], references: [id])
    doctor       User?                  @relation("DoctorRoomBookings", fields: [doctorId], references: [id])
    patient      PatientInfo?           @relation("PatientRoomBookings", fields: [patientId], references: [id])
    staySessions InpatientStaySession[] @relation("CurrentStayRoomBooking")

    @@unique([appointmentId]) // One appointment per room booking
    @@index([roomId, startTime, endTime])
    @@index([appointmentId])
    @@index([doctorId, startTime])
    @@index([startTime, endTime])
}

//<-----------------Infrastructure-----------------------

//------------------Refferal-------------------->
enum ReferralType {
    INTERNAL
    EXTERNAL
    NONE
}

model Reference {
    id                 String  @id @default(cuid())
    patientId          String
    visitId            String?
    referralEmployeeId String?
    referralId         String?
    appointmentId      String? @unique
    admissionId        String? @unique

    referralDate         DateTime      @default(now())
    reason               String?
    referralName         String?
    referralContact      String?
    referralType         ReferralType?
    concessionPercentage Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    referralEmployee EmployeeInfo?  @relation("ReferralEmployee", fields: [referralEmployeeId], references: [id])
    referralUser     ReferralUsers? @relation("ReferralUser", fields: [referralId], references: [id])
    patient          PatientInfo    @relation("RefferalPatient", fields: [patientId], references: [id])
    appointment      Appointment?   @relation(fields: [appointmentId], references: [id])
    admission        Admission?     @relation(fields: [admissionId], references: [id])
    // visit          Visit?         @relation(fields: [visitId], references: [id])
}

//<-----------------Refferal---------------------

//------------------Patient Stats---------------->
model Visit {
    id                     String  @id @default(cuid())
    patientId              String
    doctorId               String
    appointmentId          String?
    inpatientStaySessionId String?

    visitType              VisitType // OPD, IPD Follow-up, Emergency
    visitDate              DateTime    @default(now())
    chiefComplaint         String
    history                String?
    examination            String?
    diagnosis              String?
    status                 VisitStatus @default(IN_PROGRESS)
    isAdmissionRecommended Boolean     @default(false)
    testReportsToCarry     String?
    nextReviewDate         String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    inpatientStaySession InpatientStaySession? @relation(fields: [inpatientStaySessionId], references: [id])
    patient              PatientInfo           @relation(fields: [patientId], references: [id])
    doctor               EmployeeInfo          @relation(fields: [doctorId], references: [id])
    appointment          Appointment?          @relation(fields: [appointmentId], references: [id])
    admissions           Admission[]           @relation("VisitToAdmission")
    prescriptions        Prescription[]
    documents            MedicalDocument[]
    medicalHistories     MedicalHistory[]
    labOrders            LabOrder[]
    physioTherapy        PhysioTherapy[]
    patientVitals        PatientVitals[]
    treatments           Treatment[]

    @@index([patientId])
    @@index([doctorId, visitDate])
    @@index([visitDate])
}

enum VisitType {
    OPD
    IPD_FOLLOWUP
    EMERGENCY
    ROUTINE_CHECKUP
}

enum VisitStatus {
    IN_PROGRESS
    COMPLETED
    CANCELLED
    NO_SHOW
}

model PatientVitals {
    id            String   @id @default(cuid())
    patientId     String
    appointmentId String?
    admissionId   String?
    vitalsId      String
    visitId       String?
    recordedBy    String?
    time          DateTime @default(now())

    employee EmployeeInfo? @relation(fields: [recordedBy], references: [id])
    patient  PatientInfo   @relation(fields: [patientId], references: [id])
    vitals   Vitals        @relation(fields: [vitalsId], references: [id])
    visit    Visit?        @relation(fields: [visitId], references: [id])

    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt
    appointment      Appointment?     @relation(fields: [appointmentId], references: [id])
    medicalHistories MedicalHistory[]
}

model Vitals {
    id String @id @default(cuid())

    temperature String?
    bp          String?
    pulse       String?
    spo2        String?
    bloodSugar  String?
    weight      String?
    height      String?
    nurseNotes  String?

    temperatureUnit String?
    bpUnit          String?
    pulseUnit       String?
    spo2Unit        String?
    bloodSugarUnit  String?
    weightUnit      String?
    heightUnit      String?

    patientVitals PatientVitals[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum MealTime {
    BEFORE_MEAL
    AFTER_MEAL
    WITH_MEAL
    EMPTY_STOMACH
    SOS
}

model Prescription {
    id        String  @id @default(cuid())
    visitId   String?
    doctorId  String
    patientId String
    notes     String?
    discount  Int?    @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    prescriptionItems PrescriptionItem[]
    dispensations     Dispensation[]
    visit             Visit?             @relation(fields: [visitId], references: [id])
    doctor            EmployeeInfo       @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
    patient           PatientInfo        @relation("PatientPrescriptions", fields: [patientId], references: [id])
    medicalHistories  MedicalHistory[]
}

model PrescriptionItem {
    id             String    @id @default(cuid())
    prescriptionId String
    itemId         String
    dosage         String?
    frequency      String?
    duration       String?
    timing         MealTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    prescription Prescription @relation(fields: [prescriptionId], references: [id])
    item         MedicalItem  @relation(fields: [itemId], references: [id])
}

model PhysioConfiguration {
    id String @id @default(cuid())

    name            String    @unique
    description     String?
    duration        Int?
    time            DateTime?
    sets            Int?
    reps            Int?
    difficultyLevel String?
    status          String?
    isActive        Boolean?  @default(true) @map("is_active")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    PhysioTherapy PhysioTherapy[]
